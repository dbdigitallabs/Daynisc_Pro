{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd web_dashboard && npm install && npm run build",
  "outputDirectory": "web_dashboard/dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/downloads/(.*)", "dest": "/downloads/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
