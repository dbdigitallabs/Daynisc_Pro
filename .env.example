# ── AI ERP Platform — Environment Variables ───────────────────────────────────
# Copy to .env and fill in values before running docker-compose or deployment

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=generate-a-64-char-random-string-here

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=your-strong-postgres-password-here
DATABASE_URL=postgresql+asyncpg://erp:your-strong-postgres-password-here@postgres:5432/erp_db

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=generate-another-64-char-random-string-here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── AWS (Mumbai region for Indian businesses) ─────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=ap-south-1
S3_BUCKET=your-erp-documents-bucket

# ── AI / OCR ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-from-google-ai-studio
OPENAI_API_KEY=sk-...optional-fallback
AI_CONFIDENCE_THRESHOLD=0.85

# ── Tally (default — companies can override in their settings) ────────────────
TALLY_DEFAULT_URL=http://localhost:9000
TALLY_TIMEOUT=30

# ── GST Portal API ────────────────────────────────────────────────────────────
GST_CLIENT_ID=your-gsp-client-id
GST_CLIENT_SECRET=your-gsp-client-secret
GST_SANDBOX=true    # Change to false in production

# ── WhatsApp Business API ─────────────────────────────────────────────────────
# Get from: https://developers.facebook.com/docs/whatsapp
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_API_VERSION=v19.0

# ── SMS — MSG91 (Indian SMS provider) ────────────────────────────────────────
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-otp-template-id

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
FROM_EMAIL=noreply@yourdomain.com

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["https://app.aierp.in","http://localhost:3000"]

# ── Sentry (optional error tracking) ─────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ── Web Dashboard ─────────────────────────────────────────────────────────────
VITE_API_URL=https://api.aierp.in/api/v1
