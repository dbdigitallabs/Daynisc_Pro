# ── Daynisc ERP — .gitignore ──────────────────────────────────────────────────

# ── Secrets (NEVER commit these) ──────────────────────────────────────────────
.env
.env.local
.env.production
.env.*.local
*.pem
*.key
deployment/certs/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
celerybeat-schedule
celerybeat.pid

# ── Node / React Dashboard ────────────────────────────────────────────────────
web_dashboard/node_modules/
web_dashboard/dist/
web_dashboard/.vite/

# ── Flutter / Dart ────────────────────────────────────────────────────────────
mobile/.dart_tool/
mobile/.packages
mobile/.pub-cache/
mobile/.pub/
mobile/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/key.properties
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/*.iml
*.g.dart
*.freezed.dart

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Docker ────────────────────────────────────────────────────────────────────
# (Keep Dockerfile and docker-compose.yml)

# ── Database dumps ────────────────────────────────────────────────────────────
*.sql.gz
*.dump
pg_dump/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Temp / uploaded files ─────────────────────────────────────────────────────
mnt/
uploads/
tmp/
